# Copy to .env for development. Production services use /etc/eldritch-fable.env.
ELDRITCH_DB=./data/eldritch.db
ELDRITCH_ORIGIN=http://localhost:5173
PORT=3000
# Enable only after Caddy overwrites X-Eldritch-Client-IP from a trusted source.
ELDRITCH_TRUST_PROXY=none
ELDRITCH_PUBLIC_URL=https://eldritchfable.com
ELDRITCH_SEND_EMAIL=NO
SMTP_HOST=
SMTP_PORT=587
SMTP_TLS=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Disabled by default. Sandbox checkout is limited to existing administrators.
# Provision the restricted key and webhook signing secret privately on the server.
ELDRITCH_COMMERCE_MODE=disabled
ELDRITCH_STRIPE_ACCOUNT=
STRIPE_RESTRICTED_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_SHIPPING_RATE_ID=
