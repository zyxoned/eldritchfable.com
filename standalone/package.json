{
  "name": "eldritch-fable-standalone",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "start": "node --env-file-if-exists=.env server/index.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "playwright test",
    "db:migrate": "node --env-file-if-exists=.env server/database-tools.mjs migrate",
    "db:backup": "node --env-file-if-exists=.env server/database-tools.mjs backup",
    "db:restore": "node --env-file-if-exists=.env server/database-tools.mjs restore",
    "mail:run": "node --env-file-if-exists=.env server/mail-worker.mjs",
    "admin:create": "node --env-file-if-exists=.env server/provision-admin.mjs",
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.84.1",
    "lucide-react": "^0.475.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.1",
    "nodemailer": "^7.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@vitejs/plugin-react": "^4.7.0",
    "vite": "^6.3.0"
  },
  "engines": { "node": ">=24.0.0" }
}
