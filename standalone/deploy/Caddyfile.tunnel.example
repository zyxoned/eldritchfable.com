# Example for a local Cloudflare Tunnel connecting to Caddy on port 8080.
# Merge with the running configuration; retain the tunnel's existing origin port.
{
  servers {
    trusted_proxies static 127.0.0.1/32 ::1/128
    client_ip_headers CF-Connecting-IP
    trusted_proxies_strict
  }
}
:8080 {
  bind 127.0.0.1
  header {
    Referrer-Policy no-referrer
    X-Content-Type-Options nosniff
    X-Frame-Options DENY
  }
  handle /api/* {
    reverse_proxy 127.0.0.1:3000 {
      header_up X-Eldritch-Client-IP {client_ip}
    }
  }
  handle {
    root * /srv/eldritch-fable/current/standalone/dist
    try_files {path} /index.html
    file_server
  }
}
